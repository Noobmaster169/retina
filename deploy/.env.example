# Copy to .env next to compose.yaml on the Monash server. Never commit real values.
#
# auto-deploy.sh copies compose.yaml and itself from the clone, but never this
# file. A variable added here has to be added to ~/retina/.env by hand;
# deploy/bootstrap-wizard.sh does it, keeping the values already there.
#
# Everything else the backend reads has a default in backend/src/config.ts, and
# compose.yaml sets the ones that name a service. EVAL_GROUND_TRUTH_PATH stays
# out on purpose: the answer key is a file on this box only inside the inbox
# container, and setting this would put a second copy under the api. The api
# scores a run locally by asking the inbox for the key over the compose
# network instead, which compose.yaml wires up as EVAL_GROUND_TRUTH_URL.

# Password for the retina Postgres user. Postgres is private to the compose
# network, but the API and worker connect with it.
PG_PASSWORD=CHANGE_ME

# The bearer token the Next.js frontend sends. Generate: openssl rand -hex 32
# Must match API_SHARED_SECRET in the Vercel project env.
API_SHARED_SECRET=CHANGE_ME

# The bearer token teammates use to call the API directly. A different value,
# so either can be rotated on its own. Generate: openssl rand -hex 32
TEAM_API_KEY=CHANGE_ME_TOO

# Guards the inbox container's GET /ground_truth, which is how the api scores a
# run against the answer key without holding a copy of it. Optional: that
# endpoint publishes no port and is reachable only from the compose network, so
# left unset the server skips the check and local scoring still works. Set it to
# a value of your own if you would rather it were guarded twice.
# Generate: openssl rand -hex 32
# EVAL_JUDGE_TOKEN=

# MinIO root credentials, and the same values the api and worker sign requests
# with. Generate each: openssl rand -hex 16
# MinIO refuses to start if the user is under 3 or the password under 8
# characters, so do not shorten these.
MINIO_ACCESS_KEY=CHANGE_ME_32_HEX
MINIO_SECRET_KEY=CHANGE_ME_32_HEX

# The llm-proxy container's login to the Claude subscription. Not generated:
# make it with `claude setup-token` on a machine logged in to the account, and
# paste it here (the wizard asks for it). Without it the stack still comes up
# and every model call fails as "not logged in".
CLAUDE_CODE_OAUTH_TOKEN=
