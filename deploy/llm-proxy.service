# llm-proxy on the Monash box, as the student user.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp llm-proxy.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now llm-proxy
#   loginctl enable-linger student     # keeps user services running after logout
#
# Logs: journalctl --user -u llm-proxy -f
[Unit]
Description=llm-proxy (retina): Claude Code subscription + local Ollama
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/llm-proxy
Environment=LLM_PROXY_CONFIG=%h/retina/proxy.yaml
Environment=LLM_PROXY_HOST=127.0.0.1
Environment=LLM_PROXY_PORT=4000
ExecStart=%h/llm-proxy/scripts/start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
