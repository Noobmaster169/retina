# Copy to .env.local. .env* is gitignored — never commit real values.
# In production these are the Vercel project's environment variables
# (Settings → Environment Variables); nothing is baked in at build time.

# Where the Next.js server finds the backend. This one line decides whether
# you work against your local backend or the deployed one:
#   local:      http://localhost:8091   (pnpm dev in ../backend)
#   production: https://fineness-getting-crusader.ngrok-free.dev
#               (then API_SHARED_SECRET below must be the production value)
BACKEND_URL=http://localhost:8091

# Bearer token sent on every backend call. Must equal API_SHARED_SECRET in the
# backend's .env. Generate: openssl rand -hex 32
API_SHARED_SECRET=CHANGE_ME

# Optional. When set, every page redirects to /login until this password is
# entered once (a 30-day cookie; changing the password signs everyone out).
# Unset = no gate. There is no user model; this only keeps strangers from
# spending the subscription through the public page. Set it on Vercel.
SITE_PASSWORD=

# The phrase that starts a run, asked for every time one is created. Unlike the
# site gate there is no cookie and no session: a run of the whole inbox is
# thousands of model calls, so starting one is typed rather than clicked.
#
# Optional: unset, a default in the code applies. Set it to use your own.
RUN_PASSWORD=
