# Copy to .env.local and fill in. .env* is gitignored — never commit real values.
# In production these are the Vercel project's environment variables
# (Settings → Environment Variables); nothing is baked in at build time.

# Where the Next.js server finds the backend. Locally: `pnpm dev` in
# ../backend, on 8091. In prod: the retina ngrok hostname.
BACKEND_URL=http://localhost:8091

# Bearer token sent on every backend call. Must equal API_SHARED_SECRET in the
# backend's .env. Generate: openssl rand -hex 32
API_SHARED_SECRET=CHANGE_ME

# Optional. When set, every page except /login asks for this password once and
# sets a cookie. Unset = no gate. There is no user model; this only keeps
# strangers from spending the subscription through the public page.
SITE_PASSWORD=
