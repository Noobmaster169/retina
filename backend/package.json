{
  "name": "retina-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/worker.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start:worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.mjs",
    "eval:split": "node --env-file-if-exists=.env --import tsx src/eval/split.cli.ts",
    "eval:parity": "node --env-file-if-exists=.env --import tsx src/eval/parity.ts",
    "eval:score": "node --env-file-if-exists=.env --import tsx src/eval/run-eval.ts",
    "eval:sample": "node --env-file-if-exists=.env --import tsx src/eval/sample.cli.ts",
    "eval:examples": "node --env-file-if-exists=.env --import tsx src/eval/examples.cli.ts",
    "eval:chat": "node --env-file-if-exists=.env --import tsx src/eval/chat-eval.cli.ts",
    "load-test": "node --env-file-if-exists=.env --import tsx scripts/load-test.ts",
    "derive": "node --env-file-if-exists=.env --import tsx scripts/derive.ts",
    "gate:drill": "node --env-file-if-exists=.env --import tsx scripts/gate-drill.ts",
    "ontology:backfill": "node --env-file-if-exists=.env --import tsx scripts/ontology-backfill.ts",
    "ontology:bench": "node --env-file-if-exists=.env --import tsx scripts/ontology-bench.ts",
    "ontology:locate": "node --env-file-if-exists=.env --import tsx scripts/ontology-locate.ts",
    "ontology:relink": "node --env-file-if-exists=.env --import tsx scripts/ontology-relink.ts",
    "ontology:export": "node --env-file-if-exists=.env --import tsx scripts/ontology-export.ts",
    "ontology:parallel-bench": "node --env-file-if-exists=.env --import tsx scripts/ontology-parallel-bench.ts",
    "ontology:bench-compare": "node --env-file-if-exists=.env --import tsx scripts/ontology-bench-compare.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx src/mcp.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bullmq": "^6.3.6",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "multer": "^2.4.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.20.0"
}
