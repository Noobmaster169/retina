{
  "name": "retina-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/worker.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start:worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "bullmq": "^6.3.6",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.20.0"
}
