# Copy to .env. Never commit real values. src/config.ts is the only reader.

# Server
PORT=8091
LOG_LEVEL=info

# Auth: the frontend's bearer (must match frontend/.env.local) and the team's.
# Generate each with: openssl rand -hex 32
API_SHARED_SECRET=CHANGE_ME
TEAM_API_KEY=CHANGE_ME_TOO

# Postgres, Redis, MinIO and the inbox: all from compose.local.yaml
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=localdev
REDIS_URL=redis://127.0.0.1:6379
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=retina
MINIO_SECRET_KEY=retinaretina
MINIO_BUCKET=retina
MINIO_USE_SSL=false
EMAIL_SERVER_URL=http://127.0.0.1:8080

# LLM proxy: the llm-proxy container of compose.local.yaml
LLM_PROXY_URL=http://127.0.0.1:4001
# Its Claude login, from `claude setup-token`. Secret.
CLAUDE_CODE_OAUTH_TOKEN=

# Doc-extract: the doc-extract container of compose.local.yaml
DOC_EXTRACT_URL=http://127.0.0.1:8000

# Pipeline. Unset, LLM_MAX_CONCURRENCY is these two added up, because that is
# how many jobs BullMQ runs at once and all of them contend for the same model
# slots. Keep it at or under proxy.yaml's max_concurrency, which is 12.
CLASSIFY_CONCURRENCY=8
COMPARE_CONCURRENCY=4
# LLM_MAX_CONCURRENCY=12

# The commit the image was built from, for /health. The Dockerfile sets it from
# a build arg; a local process reads "dev" and that is right.
# GIT_SHA=dev
# CLASSIFY_BODY_CHARS=4000
# How much of each attachment a classify prompt that reads attachments sees, and how much of a document doc-type reads.
# CLASSIFY_ATTACHMENT_CHARS=2000
# DOC_TYPE_TEXT_CHARS=12000
# EXTRACT_TEXT_CHARS=12000

# Model overrides for experiments only. Default is sonnet.
# LLM_MODEL_CLASSIFY=sonnet
# LLM_MODEL_VERIFY=sonnet
# LLM_MODEL_TRIAGE=sonnet
# LLM_MODEL_DOC_TYPE=sonnet
# LLM_MODEL_EXTRACT=sonnet
# LLM_MODEL_EXTRACT_VERIFY=sonnet
# LLM_MODEL_FIELD_JUDGE=sonnet

# Answer key for the eval harness, dev machines only. Never set on the box.
# EVAL_GROUND_TRUTH_PATH=../emails/data_v2/ground_truth.json
