# Copy to .env and fill in. .env is gitignored — never commit real values.
# In production these come from deploy/.env on the Monash server.
# src/config.ts is the only reader; it fails on boot with the list of problems.

# Bearer token the frontend sends. Must equal API_SHARED_SECRET in the
# frontend's .env. Generate: openssl rand -hex 32
API_SHARED_SECRET=CHANGE_ME
# Bearer token teammates use to call the API directly (curl, scripts).
# A different value so either can be rotated alone.
TEAM_API_KEY=CHANGE_ME_TOO

# Discrete vars rather than one DATABASE_URL, matching the house convention.
# compose.local.yaml publishes Postgres on 5433 so it cannot collide with one
# already on 5432.
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=localdev

# Redis (BullMQ queues) and MinIO (attachments), both from compose.local.yaml.
# The API boots without them and reports them down in /health; the worker and
# the /runs routes need them.
REDIS_URL=redis://127.0.0.1:6379
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=retina
MINIO_SECRET_KEY=retinaretina
MINIO_BUCKET=retina
MINIO_USE_SSL=false

# The llm-proxy service of compose.local.yaml (built from ../proxy), published
# on host loopback 4001. Inside compose, deploy/compose.yaml points this at
# http://llm-proxy:4000. A remote /ai/chat is refused at boot: the proxy is
# part of this stack now.
LLM_PROXY_URL=http://127.0.0.1:4001

# The Claude login for the llm-proxy container. compose.local.yaml reads it from
# this file. Make one with `claude setup-token` on a machine where you are logged
# in to the Claude subscription; it is a long-lived secret, never commit it.
# CLAUDE_CODE_OAUTH_TOKEN=

# The email server from ../emails. compose.local.yaml runs it as `inbox`.
# In production the compose file points this at the `inbox` service.
EMAIL_SERVER_URL=http://127.0.0.1:8080

# How parallel a run is. CLASSIFY_CONCURRENCY emails are classified at once;
# each is one model call, two when the verifier runs. LLM_MAX_CONCURRENCY caps
# the model calls in flight across the whole worker and follows
# CLASSIFY_CONCURRENCY when unset, so one number sets the pace of every run,
# dev sample, holdout or all 520. Keep both at or under what the proxy serves
# at once (max_concurrency in proxy/proxy.yaml, 2 for claude): more only waits
# inside the proxy with its timeout already running.
CLASSIFY_CONCURRENCY=2
# LLM_MAX_CONCURRENCY=2
COMPARE_CONCURRENCY=4

# Every step runs the model its prompt file names, which is sonnet. These
# replace it for an experiment; a run can also name its own from the runs page.
# LLM_MODEL_CLASSIFY=sonnet
# LLM_MODEL_VERIFY=sonnet
# CLASSIFY_BODY_CHARS=4000

# pino level: trace, debug, info, warn, error, silent.
LOG_LEVEL=info

# Listen port. 8091 is what compose, ngrok and the frontend expect.
PORT=8091

# The answer key, for the eval harness only (pnpm eval:*). Set it on a dev
# machine. Never on the VPS: there the key lives only inside the inbox container.
# Left commented on purpose: copying this file must not hand the api the answer key.
# EVAL_GROUND_TRUTH_PATH=../emails/data_v2/ground_truth.json
