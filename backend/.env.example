# Copy to .env. Never commit real values. src/config.ts is the only reader.

# Server
PORT=8091
LOG_LEVEL=info

# Auth: the frontend's bearer (must match frontend/.env.local) and the team's.
# Generate each with: openssl rand -hex 32
API_SHARED_SECRET=CHANGE_ME
TEAM_API_KEY=CHANGE_ME_TOO

# Postgres, Redis, MinIO and the inbox: all from compose.local.yaml
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=localdev
# The role the chat agent's SQL runs as (migration 011). A role is cluster-wide,
# so this must match what the tests use: vitest.config.ts sets `localdev`.
PG_RO_PASSWORD=localdev
DATABASE_RO_URL=postgres://retina_ro:localdev@127.0.0.1:5433/postgres
REDIS_URL=redis://127.0.0.1:6379
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=retina
MINIO_SECRET_KEY=retinaretina
MINIO_BUCKET=retina
MINIO_USE_SSL=false
EMAIL_SERVER_URL=http://127.0.0.1:8080

# LLM proxy: the llm-proxy container of compose.local.yaml
LLM_PROXY_URL=http://127.0.0.1:4001
# Its Claude login, from `claude setup-token`. Secret.
CLAUDE_CODE_OAUTH_TOKEN=

# Doc-extract: the doc-extract container of compose.local.yaml
DOC_EXTRACT_URL=http://127.0.0.1:8000

# Pipeline: ten emails in flight per stage. Leave these unset; a pinned copy in
# a .env is how the code and the box ended up running different numbers.
# LLM_MAX_CONCURRENCY is the two added up, because that is how many jobs BullMQ
# runs at once and all of them contend for the same model slots. Keep it at or
# under proxy.yaml's max_concurrency, which is 30 with the ontology lane.
# CLASSIFY_CONCURRENCY=10
# COMPARE_CONCURRENCY=10
# LLM_MAX_CONCURRENCY=20
# The semantic layer's queue, ten like the others. Left out of the sum on purpose:
# it has a model lane of its own, so a reading cannot take a scored call's slot.
# proxy.yaml's max_concurrency is the three lanes added up (10 + 10 + 10).
# ONTOLOGY_CONCURRENCY=10

# The commit the image was built from, for /health. The Dockerfile sets it from
# a build arg; a local process reads "dev" and that is right.
# GIT_SHA=dev
# CLASSIFY_BODY_CHARS=4000
# How much of each attachment a classify prompt that reads attachments sees, and how much of a document doc-type reads.
# CLASSIFY_ATTACHMENT_CHARS=2000
# DOC_TYPE_TEXT_CHARS=12000
# EXTRACT_TEXT_CHARS=12000
# SHIPMENT_TEXT_CHARS=14000

# The semantic layer. `mail` leaves every profile's `general` section null, so
# a question about a region is answered only where a mail says the region.
# ONTOLOGY_KNOWLEDGE=mail+model
# Starting values. Measure with `pnpm eval:chat --set ontology` before moving one.
# JUDGE_BUDGET=400
# JUDGE_BATCH=40
# CANDIDATE_CAP=5000
# PROFILE_BATCH=50
# PROFILE_FLOOR_HOURS=24
# How long a profile or concept pass may hold an ontology slot before it stops
# and leaves the rest to the next tick.
# MAINTENANCE_BUDGET_MS=240000

# Model overrides for experiments only. Default is sonnet.
# LLM_MODEL_CLASSIFY=sonnet
# LLM_MODEL_VERIFY=sonnet
# LLM_MODEL_TRIAGE=sonnet
# LLM_MODEL_DOC_TYPE=sonnet
# LLM_MODEL_EXTRACT=sonnet
# LLM_MODEL_EXTRACT_VERIFY=sonnet
# LLM_MODEL_FIELD_JUDGE=sonnet
# LLM_MODEL_VISION_READ=sonnet
# LLM_MODEL_CHAT=sonnet
# LLM_MODEL_SHIPMENT_READ=sonnet
# LLM_MODEL_ENTITY_RESOLVE=sonnet
# LLM_MODEL_ENTITY_PROFILE=sonnet
# LLM_MODEL_CONCEPT_DEFINE=sonnet
# LLM_MODEL_CONCEPT_JUDGE=sonnet

# Answer key for the eval harness, dev machines only. Never set on the box.
# EVAL_GROUND_TRUTH_PATH=../emails/data_v2/ground_truth.json
